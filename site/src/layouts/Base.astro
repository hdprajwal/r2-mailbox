---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { REPO_URL } from '../lib/routes.mjs';

interface Props {
  title: string;
  description?: string;
  /** Landing page uses the wide column too; docs need room for the sidebar. */
  width?: 'narrow' | 'wide';
}

const { title, description, width = 'wide' } = Astro.props;
const column = width === 'wide' ? 'max-w-6xl' : 'max-w-2xl';
const onDocs = Astro.url.pathname.startsWith('/docs');
const fullTitle = title === 'r2-mailbox' ? title : `${title} | r2-mailbox`;
const btn =
  'text-muted-foreground hover:text-foreground inline-flex h-7 w-7 items-center justify-center transition-[color,scale] duration-160 ease-out active:scale-[0.97]';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.ico" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#ffffff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000000"
    />
    <script is:inline>
      // Same storage key and default as next-themes on the portfolio: follow
      // the system until the reader picks a theme.
      (() => {
        const saved = localStorage.getItem('theme');
        const dark =
          saved === 'dark' ||
          (saved !== 'light' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <header
        class="border-border bg-background/85 sticky top-0 z-40 border-b backdrop-blur-md"
      >
        <div
          class:list={[
            'mx-auto flex h-14 w-full items-center justify-between px-4',
            column,
          ]}
        >
          <a
            href="/"
            class="text-foreground-strong text-title hover:text-foreground-soft inline-flex items-center gap-2 transition-colors"
          >
            <span
              aria-hidden="true"
              class="border-border bg-muted inline-flex h-6 w-6 items-center justify-center rounded-md border"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-3.5 w-3.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </span>
            r2-mailbox
          </a>
          <nav class="flex items-center gap-1.5">
            <a
              href="/docs/"
              aria-current={onDocs ? 'page' : undefined}
              class:list={[
                'text-meta rounded-md px-2.5 py-1 transition-colors',
                onDocs
                  ? 'bg-accent text-foreground-strong'
                  : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              Docs
            </a>
            <span class="bg-border mx-1 h-4 w-px"></span>
            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="border-border text-foreground-strong hover:border-foreground text-meta rounded-md border px-2.5 py-0.5 transition-[border-color,scale] duration-160 ease-out active:scale-[0.97]"
            >
              GitHub
            </a>
            <button
              id="theme-toggle"
              type="button"
              class={btn}
              aria-label="Toggle theme"
            >
              <svg
                aria-hidden="true"
                class="hidden h-3.5 w-3.5 dark:block"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path
                  d="M12 2v2M12 20v2m-7.07-14.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                ></path>
              </svg>
              <svg
                aria-hidden="true"
                class="h-3.5 w-3.5 dark:hidden"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </button>
          </nav>
        </div>
      </header>

      <main class:list={['mx-auto w-full flex-1 px-4', column]}>
        <slot />
      </main>

      <footer class:list={['mx-auto w-full px-4', column]}>
        <div class="bg-muted mt-1 h-px w-full"></div>
        <div class="flex items-start justify-between gap-4 pt-6 pb-10">
          <p class="text-muted-foreground text-meta">
            &copy; 2026 <a
              href="https://hdprajwal.dev"
              class="hover:text-foreground transition-colors">Prajwal HD</a
            >
          </p>
          <div class="flex items-center gap-4">
            <a
              href={REPO_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-foreground transition-colors"
              aria-label="GitHub"
            >
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" aria-hidden="true">
                <path
                  fill="currentColor"
                  fill-rule="evenodd"
                  d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                ></path>
              </svg>
            </a>
            <span class="bg-border h-3.5 w-px"></span>
            <a
              href={`${REPO_URL}/blob/main/LICENSE`}
              class="text-muted-foreground hover:text-foreground text-meta transition-colors"
            >
              MIT License
            </a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const dark = !root.classList.contains('dark');
        root.classList.toggle('dark', dark);
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      });

      // Copy buttons on code blocks, shown on hover like the portfolio's.
      const copyIcon =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
      const checkIcon =
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

      document.querySelectorAll('.typeset pre, .code-panel pre').forEach((pre) => {
        const wrap = document.createElement('div');
        wrap.className = 'code-wrap';
        pre.replaceWith(wrap);
        wrap.append(pre);

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'copy-btn';
        button.setAttribute('aria-label', 'Copy code');
        button.innerHTML = copyIcon;
        button.addEventListener('click', async () => {
          await navigator.clipboard.writeText(
            (pre.textContent ?? '').trimEnd()
          );
          button.innerHTML = checkIcon;
          button.setAttribute('aria-label', 'Copied');
          setTimeout(() => {
            button.innerHTML = copyIcon;
            button.setAttribute('aria-label', 'Copy code');
          }, 1400);
        });
        wrap.append(button);
      });
    </script>
  </body>
</html>
