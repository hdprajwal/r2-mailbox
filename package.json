{
  "name": "r2-mailbox",
  "version": "0.1.0",
  "private": true,
  "description": "A private email inbox on your own domain, built on Cloudflare Email Routing, an Email Worker, and R2.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "./scripts/setup.sh",
    "deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "tail": "wrangler tail --config worker/wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "check": "python3 -I reader/mailbox.py check"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
